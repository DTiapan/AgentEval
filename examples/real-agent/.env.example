# Copy to examples/real-agent/.env and fill in. The server reads this file.
# OpenRouter (preferred — LiteLLM-style routing happens server-side):
OPENROUTER_API_KEY=
# Model slug on OpenRouter (change freely, e.g. anthropic/claude-3-5-haiku):
AGENTEVAL_REAL_AGENT_MODEL=openai/gpt-4o-mini
# Alternative: plain OpenAI instead of OpenRouter:
# OPENAI_API_KEY=
