# ==============================================================================
# AgentEval — Google Cloud Platform (Cloud Run) Deployment Configuration
# Copy this file to .env.gcp (gitignored) and run:
#   AGENTEVAL_ENV_FILE=.env.gcp ./deploy/gcp/deploy.sh
# ==============================================================================

# GCP Target Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
SERVICE_NAME=agenteval-service
REPO_NAME=agenteval-repo

# Cloud Run Compute Resources
CPU=2
MEMORY=4Gi
MIN_INSTANCES=0
# Autoscaling instance ceiling.
# CRITICAL: Must be kept at 1 when using SQLite on GCS FUSE to prevent multi-instance split-brain
# database corruption (ADR-007). Increase to >1 only when connecting to managed PostgreSQL via DATABASE_URL.
MAX_INSTANCES=1
# Cloud Run Request Timeout in seconds (default: 1800 = 30 minutes).
# Synchronous runs of full assurance suites (40-60 tests with LLM judges) take 10-25 minutes.
# Cloud Run Gen2 supports up to 3600s. Set >= 1800 until Slice 6 (async background execution).
TIMEOUT=1800
CONCURRENCY=20

# Persistent Volume Storage (Cloud Storage Volume Mount on Cloud Run Gen2)
# Stores SQLite database (agenteval.db), test suites, runs, and reports across redeploys
GCS_DATA_BUCKET=
AGENTEVAL_DATA_DIR=/app/data
AGENTEVAL_USE_SQLITE=1

# Dual-Engine Persistence: Managed PostgreSQL / Cloud SQL (ADR-007)
# When configured, AgentEval bypasses SQLite single-writer limits and unlocks
# horizontal autoscaling (MAX_INSTANCES=10+).
# DATABASE_URL=postgresql://agenteval:password@10.0.0.3:5432/agenteval
# CLOUD_SQL_INSTANCE=your-gcp-project-id:us-central1:agenteval-pg
# POSTGRES_MAX_INSTANCES=10

# Networking & VPC (Optional)
# If your evaluated agents run inside a VPC (GCE VMs, GKE, private Cloud Run),
# deploy/gcp/vpc-network.sh creates a Serverless VPC Access connector:
# VPC_CONNECTOR_NAME=agenteval-vpc-connector
# VPC_EGRESS=private-ranges-only
#
# Security: By default, AgentEval blocks private RFC 1918 and loopback IPs to prevent SSRF.
# Cloud metadata (169.254.169.254) is ALWAYS blocked. Set to 1 ONLY if evaluating internal VPC agents:
# AGENTEVAL_ALLOW_PRIVATE_ENDPOINTS=0
#
# CORS Origin Restrictions: By default, restricted to Vite dev ports and local console.
# Set comma-separated allowed origins when hosting Web Console or API under distinct FQDNs:
# AGENTEVAL_CORS_ORIGINS=https://console.agenteval.app,https://staging.agenteval.app

# Evaluator LLM Gateway & Secret Manager
# Recommendation: Store secrets in Google Cloud Secret Manager instead of plain text:
#   gcloud secrets create openrouter-api-key --data-file=- <<< "your-key"
#   gcloud secrets create deepseek-api-key --data-file=- <<< "your-key"
#   gcloud secrets create openai-api-key --data-file=- <<< "your-key"
#   gcloud secrets create typesafe-api-key --data-file=- <<< "your-key"
# deploy.sh automatically detects these in Secret Manager and binds them to Cloud Run.
#
# If you prefer setting them directly in .env.gcp (not recommended for production):
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# TYPESAFE_API_KEY=

# Model and Evaluator Settings
AGENTEVAL_REAL_AGENT_MODEL=deepseek/deepseek-v4-flash-0731
# AGENTEVAL_FORCE_OFFLINE=0
# AGENTEVAL_FORCE_LOCAL=0

# Optional Domain Packs (e.g. fintech)
AGENTEVAL_ENABLED_DOMAIN_PACKS=fintech
